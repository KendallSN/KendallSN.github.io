---
import { languageMeta, languages } from '../i18n/ui';
import type { Lang } from '../i18n/ui';
import { swapLangPath, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const pathname = Astro.url.pathname;
---

<div class="lang-switch" role="group" aria-label={t('common.languageSwitcher')}>
  {
    languages.map((code, index) => (
      <>
        {index > 0 && (
          <span class="lang-sep" aria-hidden="true">
            |
          </span>
        )}
        <a
          class="lang-link"
          href={swapLangPath(pathname, code)}
          hreflang={code}
          lang={code}
          aria-label={languageMeta[code].label}
          aria-current={code === lang ? 'true' : undefined}
          title={code === lang ? undefined : t('common.languageSwitcherHint')}
        >
          {languageMeta[code].short}
        </a>
      </>
    ))
  }
</div>
